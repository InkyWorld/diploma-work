# Налаштування для FastAPI
DEBUG=True

# Налаштування Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=1234
REDIS_DB=0

# JWT налаштування
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Параметри підключення до бази даних
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=system_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Не редагуй вручну, генерується автоматично (наприклад, у settings.py)
# DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@localhost:5432/system_db
